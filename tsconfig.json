{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "moduleResolution": "node16",
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": true,
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/__tests__/*.ts",
    "src/**/__mocks__/*.ts"
  ],
  "compileOnSave": true
}
